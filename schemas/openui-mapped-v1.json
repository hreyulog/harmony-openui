{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "Stack": {
      "$ref": "#/$defs/Stack"
    },
    "Card": {
      "$ref": "#/$defs/Card"
    },
    "CardHeader": {
      "$ref": "#/$defs/CardHeader"
    },
    "TextContent": {
      "$ref": "#/$defs/TextContent"
    },
    "Image": {
      "$ref": "#/$defs/Image"
    },
    "Button": {
      "$ref": "#/$defs/Button"
    },
    "Select": {
      "$ref": "#/$defs/Select"
    },
    "SelectItem": {
      "$ref": "#/$defs/SelectItem"
    },
    "FormControl": {
      "$ref": "#/$defs/FormControl"
    },
    "Input": {
      "$ref": "#/$defs/Input"
    },
    "TextArea": {
      "$ref": "#/$defs/TextArea"
    },
    "CheckBoxGroup": {
      "$ref": "#/$defs/CheckBoxGroup"
    },
    "CheckBoxItem": {
      "$ref": "#/$defs/CheckBoxItem"
    },
    "Buttons": {
      "$ref": "#/$defs/Buttons"
    },
    "Form": {
      "$ref": "#/$defs/Form"
    },
    "RadioItem": {
      "$ref": "#/$defs/RadioItem"
    },
    "RadioGroup": {
      "$ref": "#/$defs/RadioGroup"
    },
    "SwitchItem": {
      "$ref": "#/$defs/SwitchItem"
    },
    "SwitchGroup": {
      "$ref": "#/$defs/SwitchGroup"
    }
  },
  "required": [
    "Stack",
    "Card",
    "CardHeader",
    "TextContent",
    "Image",
    "Button",
    "Select",
    "SelectItem",
    "FormControl",
    "Input",
    "TextArea",
    "CheckBoxGroup",
    "CheckBoxItem",
    "Buttons",
    "Form",
    "RadioItem",
    "RadioGroup",
    "SwitchItem",
    "SwitchGroup"
  ],
  "additionalProperties": false,
  "$defs": {
    "Stack": {
      "type": "object",
      "properties": {
        "children": {
          "type": "array",
          "items": {}
        },
        "direction": {
          "type": "string",
          "enum": [
            "row",
            "column"
          ]
        },
        "gap": {
          "type": "string",
          "enum": [
            "none",
            "xs",
            "s",
            "m",
            "l",
            "xl",
            "2xl"
          ]
        },
        "align": {
          "type": "string",
          "enum": [
            "start",
            "center",
            "end",
            "stretch",
            "baseline"
          ]
        },
        "justify": {
          "type": "string",
          "enum": [
            "start",
            "center",
            "end",
            "between",
            "around",
            "evenly"
          ]
        },
        "wrap": {
          "type": "boolean"
        }
      },
      "required": [
        "children"
      ],
      "additionalProperties": false,
      "description": "An ordinary row or column of children. This native profile supports wrap=false only."
    },
    "Card": {
      "type": "object",
      "properties": {
        "children": {
          "type": "array",
          "items": {}
        },
        "variant": {
          "type": "string",
          "enum": [
            "card",
            "clear"
          ]
        },
        "direction": {
          "type": "string",
          "enum": [
            "row",
            "column"
          ]
        },
        "gap": {
          "type": "string",
          "enum": [
            "none",
            "xs",
            "s",
            "m",
            "l",
            "xl",
            "2xl"
          ]
        },
        "align": {
          "type": "string",
          "enum": [
            "start",
            "center",
            "end",
            "stretch",
            "baseline"
          ]
        },
        "justify": {
          "type": "string",
          "enum": [
            "start",
            "center",
            "end",
            "between",
            "around",
            "evenly"
          ]
        },
        "wrap": {
          "type": "boolean"
        }
      },
      "required": [
        "children"
      ],
      "additionalProperties": false,
      "description": "A native card composed from ordinary image, text and button children. No domain-specific business logic."
    },
    "CardHeader": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "A card title and optional short subtitle."
    },
    "TextContent": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "size": {
          "type": "string",
          "enum": [
            "small",
            "default",
            "large",
            "small-heavy",
            "large-heavy"
          ]
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false,
      "description": "Plain native text. Markdown is not supported in this profile."
    },
    "Image": {
      "type": "object",
      "properties": {
        "alt": {
          "type": "string"
        },
        "src": {
          "type": "string"
        }
      },
      "required": [
        "alt"
      ],
      "additionalProperties": false,
      "description": "A native image. Use only an exact supplied HTTPS URL and meaningful alternative text."
    },
    "Button": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/ActionExpression"
        },
        "variant": {
          "type": "string",
          "enum": [
            "primary",
            "secondary",
            "tertiary"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "normal",
            "destructive"
          ]
        },
        "size": {
          "type": "string",
          "enum": [
            "extra-small",
            "small",
            "medium",
            "large"
          ]
        }
      },
      "required": [
        "label"
      ],
      "additionalProperties": false,
      "description": "An action button. Set and Reset update local state; ToAssistant and OpenUrl return intent to the host. A primary ToAssistant inside a Form validates the live values before returning formState."
    },
    "ActionExpression": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "open_url"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "url"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "continue_conversation"
            },
            "context": {
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "params": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Select": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SelectItem"
          }
        },
        "placeholder": {
          "type": "string"
        },
        "rules": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "value": {
          "type": "string"
        },
        "size": {
          "type": "string",
          "enum": [
            "small",
            "medium",
            "large"
          ]
        }
      },
      "required": [
        "name",
        "items"
      ],
      "additionalProperties": false,
      "description": "A native select. Bind value to a declared $state variable to update the UI locally. Use FormControl to label it."
    },
    "SelectItem": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "value",
        "label"
      ],
      "additionalProperties": false,
      "description": "A supplied select option; value is its stable business key."
    },
    "FormControl": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "input": {
          "anyOf": [
            {
              "$ref": "#/$defs/Input"
            },
            {
              "$ref": "#/$defs/TextArea"
            },
            {
              "$ref": "#/$defs/Select"
            },
            {
              "$ref": "#/$defs/CheckBoxGroup"
            },
            {
              "$ref": "#/$defs/RadioGroup"
            }
          ]
        },
        "hint": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "input"
      ],
      "additionalProperties": false,
      "description": "A visible label, supported input and optional hint."
    },
    "Input": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "placeholder": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "text"
        },
        "rules": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "description": "A native single-line text field. This bounded profile accepts type=text only. Bind value to a declared $state or leave it local to its named Form."
    },
    "TextArea": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "placeholder": {
          "type": "string"
        },
        "rows": {
          "type": "number",
          "const": 3
        },
        "rules": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "description": "A native multiline text field. This bounded profile uses three native rows. Bind value to a declared $state or leave it local to its named Form."
    },
    "CheckBoxGroup": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CheckBoxItem"
          }
        },
        "rules": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "value": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "boolean"
          }
        }
      },
      "required": [
        "name",
        "items"
      ],
      "additionalProperties": false,
      "description": "A set of independent choices stored as a record of item name to boolean. A required group needs at least one checked item. The official spelling has a capital B."
    },
    "CheckBoxItem": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "defaultChecked": {
          "type": "boolean"
        }
      },
      "required": [
        "label",
        "description",
        "name"
      ],
      "additionalProperties": false,
      "description": "One named boolean choice. description is required by the upstream signature; use an empty string when unnecessary."
    },
    "RadioGroup": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RadioItem"
          }
        },
        "defaultValue": {
          "type": "string"
        },
        "rules": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "items"
      ],
      "additionalProperties": false,
      "description": "A native radio group with optional defaultValue and reactive value binding. A supplied current value wins over the default. Use FormControl for a visible group label."
    },
    "RadioItem": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "description",
        "value"
      ],
      "additionalProperties": false,
      "description": "One radio choice. description is required by the upstream signature; use an empty string if unnecessary. value is the stable business key."
    },
    "Buttons": {
      "type": "object",
      "properties": {
        "buttons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Button"
          }
        },
        "direction": {
          "type": "string",
          "enum": [
            "row",
            "column"
          ]
        }
      },
      "required": [
        "buttons"
      ],
      "additionalProperties": false,
      "description": "A reusable group of action buttons. Official default direction is row; use column for long mobile captions."
    },
    "Form": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "buttons": {
          "$ref": "#/$defs/Buttons"
        },
        "fields": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/$defs/FormControl"
          }
        }
      },
      "required": [
        "name",
        "buttons",
        "fields"
      ],
      "additionalProperties": false,
      "description": "A named form with explicit buttons and labelled fields. Form(name, Buttons([...]), fields). Do not nest forms or invent a Submit action; use @ToAssistant and the host receives the validated live formState."
    },
    "SwitchItem": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "defaultChecked": {
          "type": "boolean"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "description": "One named switch. Supply a human-readable label when possible; an omitted or empty label falls back to its stable name in this native profile."
    },
    "SwitchGroup": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SwitchItem"
          }
        },
        "variant": {
          "type": "string",
          "enum": [
            "clear",
            "card",
            "sunk"
          ]
        },
        "value": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "boolean"
          }
        }
      },
      "required": [
        "name",
        "items"
      ],
      "additionalProperties": false,
      "description": "Independent switches stored as a boolean record, using the same aggregate semantics as CheckBoxGroup. There is no rules argument. Only clear and card variants are supported natively."
    }
  }
}
