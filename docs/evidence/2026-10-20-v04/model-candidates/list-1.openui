root = Stack([heading, notice, filters, resetButton, $kind == "all" || $kind == "park" ? ($duration == "all" || $duration == "short") ? lakeWalk : null : null, $kind == "all" || $kind == "museum" ? ($duration == "all" || $duration == "long") ? cityMuseum : null : null, $kind == "all" || $kind == "bookstore" ? ($duration == "all" || $duration == "short") ? cornerBooks : null : null, $kind == "all" || $kind == "park" ? ($duration == "all" || $duration == "long") ? forestTrail : null : null, noResults], "column", "m")
$kind = "all"
$duration = "all"
heading = CardHeader("周末去哪里", "轻松发现周末去处")
notice = TextContent("虚构演示；图片为活动类型配图，非场馆实景。")
filters = Stack([kindControl, durationControl], "column", "s")
kindControl = FormControl("类型", Select("kind", [SelectItem("all", "全部类型"), SelectItem("park", "公园步道"), SelectItem("museum", "展馆"), SelectItem("bookstore", "书店")], "请选择类型", null, $kind))
durationControl = FormControl("时长", Select("duration", [SelectItem("all", "不限时长"), SelectItem("short", "约1小时"), SelectItem("long", "约2小时")], "请选择时长", null, $duration))
resetButton = Button("重置筛选", @Reset($kind, $duration), "tertiary")
lakeWalk = Card([lakeWalkImage, lakeWalkHeader, lakeWalkDetail, lakeWalkButton], "card", "column", "s")
lakeWalkImage = Image("湖畔慢走配图", "https://images.unsplash.com/photo-1470770841072-f978cf4d019e?w=800&q=75&fit=crop")
lakeWalkHeader = CardHeader("湖畔慢走", "户外散步")
lakeWalkDetail = TextContent("户外 · 约 1 小时 · 适合轻松散步")
lakeWalkButton = Button("选择湖畔慢走", @ToAssistant("选择湖畔慢走", {itemId:"lake-walk"}))
cityMuseum = Card([cityMuseumImage, cityMuseumHeader, cityMuseumDetail, cityMuseumButton], "card", "column", "s")
cityMuseumImage = Image("城市展馆配图", "https://images.unsplash.com/photo-1518998053901-5348d3961a04?w=800&q=75&fit=crop")
cityMuseumHeader = CardHeader("城市展馆", "主题展览")
cityMuseumDetail = TextContent("室内 · 约 2 小时 · 看一场主题展览")
cityMuseumButton = Button("选择城市展馆", @ToAssistant("选择城市展馆", {itemId:"city-museum"}))
cornerBooks = Card([cornerBooksImage, cornerBooksHeader, cornerBooksDetail, cornerBooksButton], "card", "column", "s")
cornerBooksImage = Image("街角书店配图", "https://images.unsplash.com/photo-1481627834876-b7833e8f5570?w=800&q=75&fit=crop")
cornerBooksHeader = CardHeader("街角书店", "阅读与休息")
cornerBooksDetail = TextContent("室内 · 约 1 小时 · 阅读与休息")
cornerBooksButton = Button("选择街角书店", @ToAssistant("选择街角书店", {itemId:"corner-books"}))
forestTrail = Card([forestTrailImage, forestTrailHeader, forestTrailDetail, forestTrailButton], "card", "column", "s")
forestTrailImage = Image("林间步道配图", "https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=800&q=75&fit=crop")
forestTrailHeader = CardHeader("林间步道", "步行探索")
forestTrailDetail = TextContent("户外 · 约 2 小时 · 适合步行探索")
forestTrailButton = Button("选择林间步道", @ToAssistant("选择林间步道", {itemId:"forest-trail"}))
noResults = !((($kind == "all" || $kind == "park") && ($duration == "all" || $duration == "short")) || (($kind == "all" || $kind == "museum") && ($duration == "all" || $duration == "long")) || (($kind == "all" || $kind == "bookstore") && ($duration == "all" || $duration == "short"))) || ($kind == "all" || $kind == "park") && ($duration == "all" || $duration == "long") ? TextContent("没有匹配结果，请调整筛选") : null