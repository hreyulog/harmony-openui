root = Stack([result])
$result = Card([header, image, details], "card", "column", "m")
$header = CardHeader("计划已收到", "仅演示，未预订")
$image = Image("林间步道配图，非场馆实景", "https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=800&q=75&fit=crop")
$details = Stack([name, notes, place, gear], "column", "xs")
$name = TextContent("计划名称：Walk")
$notes = TextContent("备注：BringWater")
$place = TextContent("去处：林间步道 · 户外 · 约 2 小时 · 适合步行探索")
$gear = Stack([camera, water], "column", "xs")
$camera = TextContent("准备物品：带相机")
$water = TextContent("准备物品：带水")