root = Stack([heading, photo, shortFacts, destination, note], "column", "m")
heading = CardHeader("计划已收到", "仅演示，未预订，未创建提醒")
photo = Card([Image("公园林间步道入口示例图，与选择处无对应关系", "https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=800&q=75&fit=crop")], "clear", "column", "s")
shortFacts = Card([planRow, reminderRow, transportRow, accessibilityRow], "card", "column", "s")
planRow = Stack([planLabel, planValue], "row", "m")
planLabel = TextContent("计划名称：", "small")
planValue = TextContent("周末慢游", "large-heavy")
reminderRow = Stack([reminderLabel, reminderValue], "row", "m")
reminderLabel = TextContent("出发提醒：", "small")
reminderValue = TextContent("已选", "large-heavy")
transportRow = Stack([transportLabel, transportValue], "row", "m")
transportLabel = TextContent("出行方式：", "small")
transportValue = TextContent("公共交通", "large-heavy")
accessibilityRow = Stack([accessibilityLabel, accessibilityValue], "row", "m")
accessibilityLabel = TextContent("无障碍路线：", "small")
accessibilityValue = TextContent("未选", "large-heavy")
destination = Card([destinationLabel, destinationValue], "card", "column", "xs")
destinationLabel = TextContent("去处：", "small")
destinationValue = TextContent("林间步道", "large-heavy")
note = Card([noteLabel, noteValue], "card", "column", "xs")
noteLabel = TextContent("备注：", "small")
noteValue = TextContent("带水和雨伞", "large-heavy")