root = Stack([heading, notice, filters, reset, ($kind == "all" || $kind == "park") && ($duration == "all" || $duration == "short") ? lakeWalkCard : null, ($kind == "all" || $kind == "museum") && ($duration == "all" || $duration == "long") ? cityMuseumCard : null, ($kind == "all" || $kind == "bookstore") && ($duration == "all" || $duration == "short") ? cornerBooksCard : null, ($kind == "all" || $kind == "park") && ($duration == "all" || $duration == "long") ? forestTrailCard : null, ($kind != "all" || $duration != "all") && !(($kind == "all" || $kind == "park") && ($duration == "all" || $duration == "short")) && !(($kind == "all" || $kind == "museum") && ($duration == "all" || $duration == "long")) && !(($kind == "all" || $kind == "bookstore") && ($duration == "all" || $duration == "short")) && !(($kind == "all" || $kind == "park") && ($duration == "all" || $duration == "long")) ? noResult : null], "column", "m", "stretch", "start", false)
$kind = "all"
$duration = "all"
heading = CardHeader("周末去哪里", "按类型与时长筛选虚构演示去处")
notice = TextContent("虚构演示：以下地点均为演示资料。图片为活动类型配图，非场馆实景；未提供实时价格、地址或营业信息。", "small")
filters = Stack([kindControl, durationControl], "column", "m", "stretch", "start", false)
kindControl = FormControl("类型", Select("kind", [SelectItem("all", "全部类型"), SelectItem("park", "公园步道"), SelectItem("museum", "展馆"), SelectItem("bookstore", "书店")], "选择类型", null, $kind), "all 不限制类型")
durationControl = FormControl("时长", Select("duration", [SelectItem("all", "不限时长"), SelectItem("short", "约1小时"), SelectItem("long", "约2小时")], "选择时长", null, $duration), "all 不限制时长")
reset = Button("重置筛选", @Reset($kind, $duration), "tertiary")
lakeWalkCard = Card([lakeWalkImage, lakeWalkHeader, lakeWalkDetail, lakeWalkButton], "card", "column", "m", "stretch", "start", false)
lakeWalkImage = Image("湖畔慢走活动类型配图，非场馆实景", "https://images.unsplash.com/photo-1470770841072-f978cf4d019e?w=800&q=75&fit=crop")
lakeWalkHeader = CardHeader("湖畔慢走", "公园步道 · 约 1 小时")
lakeWalkDetail = TextContent("户外 · 约 1 小时 · 适合轻松散步", "default")
lakeWalkButton = Button("选择湖畔慢走", @ToAssistant("选择湖畔慢走", {itemId:"lake-walk"}))
cityMuseumCard = Card([cityMuseumImage, cityMuseumHeader, cityMuseumDetail, cityMuseumButton], "card", "column", "m", "stretch", "start", false)
cityMuseumImage = Image("城市展馆活动类型配图，非场馆实景", "https://images.unsplash.com/photo-1518998053901-5348d3961a04?w=800&q=75&fit=crop")
cityMuseumHeader = CardHeader("城市展馆", "展馆 · 约 2 小时")
cityMuseumDetail = TextContent("室内 · 约 2 小时 · 看一场主题展览", "default")
cityMuseumButton = Button("选择城市展馆", @ToAssistant("选择城市展馆", {itemId:"city-museum"}))
cornerBooksCard = Card([cornerBooksImage, cornerBooksHeader, cornerBooksDetail, cornerBooksButton], "card", "column", "m", "stretch", "start", false)
cornerBooksImage = Image("街角书店活动类型配图，非场馆实景", "https://images.unsplash.com/photo-1481627834876-b7833e8f5570?w=800&q=75&fit=crop")
cornerBooksHeader = CardHeader("街角书店", "书店 · 约 1 小时")
cornerBooksDetail = TextContent("室内 · 约 1 小时 · 阅读与休息", "default")
cornerBooksButton = Button("选择街角书店", @ToAssistant("选择街角书店", {itemId:"corner-books"}))
forestTrailCard = Card([forestTrailImage, forestTrailHeader, forestTrailDetail, forestTrailButton], "card", "column", "m", "stretch", "start", false)
forestTrailImage = Image("林间步道活动类型配图，非场馆实景", "https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=800&q=75&fit=crop")
forestTrailHeader = CardHeader("林间步道", "公园步道 · 约 2 小时")
forestTrailDetail = TextContent("户外 · 约 2 小时 · 适合步行探索", "default")
forestTrailButton = Button("选择林间步道", @ToAssistant("选择林间步道", {itemId:"forest-trail"}))
noResult = TextContent("没有匹配结果，请调整筛选", "default")