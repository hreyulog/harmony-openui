{
  "app": {
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "compatibleSdkVersion": "6.0.0(20)",
        "targetSdkVersion": "6.1.1(24)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      { "name": "debug" },
      { "name": "release" }
    ]
  },
  "modules": [
    {
      "name": "openui",
      "srcPath": "./openui",
      "targets": [{ "name": "default", "applyToProducts": ["default"] }]
    },
    {
      "name": "demo",
      "srcPath": "./demo",
      "targets": [{ "name": "default", "applyToProducts": ["default"] }]
    }
  ]
}
