field1 = Stack([TextContent("计划名称：", "small"), TextContent("周末慢游", "large-heavy")], "column", "xs")
field2 = Stack([TextContent("备注：", "small"), TextContent("带水和雨伞", "large-heavy")], "column", "xs")
